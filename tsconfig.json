{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "nodenext",
    "target": "ES2022",
    "types": ["node"],
  
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
  },
  "include": ["src/**/*.ts"],
  "exclude": [  //excluded files may still be compiled if they are imported by an included file
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/tests/**"
  ]
}
